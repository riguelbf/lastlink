# Copy this file to `.env` and adjust values as needed

# --- Logging sinks (optional, direct shipping) ---
# Enable direct shipping to Elasticsearch (otherwise use an agent like Filebeat)
LOG_ELASTICSEARCH_ENABLED=false
# Single node URI (http/https). For clusters, prefer an agent.
LOG_ELASTICSEARCH_NODE_URIS=http://localhost:9200
# Index naming format
LOG_ELASTICSEARCH_INDEX_FORMAT=webapp-logs-{0:yyyy.MM}

# Enable direct shipping to Grafana Loki (otherwise use Promtail)
LOG_LOKI_ENABLED=false
LOG_LOKI_URI=http://localhost:3100

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development

# --- OpenAPI UI ---
# Enable Scalar UI regardless of environment (default: true in Development)
SCALAR_ENABLED=true

# --- HTTP Clients (Refit) ---
# Optional base URL for dynamic API client; can be empty
DYNAMIC_API_BASE_URL=

# --- Database connection strings (EF Core) ---
# When using Aspire's AppHost with the provided MySQL container, these defaults will work:
# Server=localhost;Port=3307;Database=...;User=app;Password=apppwd;SslMode=None;AllowPublicKeyRetrieval=True
ConnectionStrings__BillingWrite=Server=localhost;Port=3307;Database=billing_write;User=app;Password=apppwd;SslMode=None;AllowPublicKeyRetrieval=True
ConnectionStrings__BillingRead=Server=localhost;Port=3307;Database=billing_read;User=app;Password=apppwd;SslMode=None;AllowPublicKeyRetrieval=True
